rules_version = '2';

// Planline accounts: each signed-in visitor can read and change only their own projects.
// Paste this whole file into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/projects/{projectId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'updated', 'data', 'v'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 300
        && request.resource.data.updated is int
        && request.resource.data.data is string && request.resource.data.data.size() <= 1000000;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
